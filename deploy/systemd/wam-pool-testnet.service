[Unit]
Description=WAM Coin stratum pool (testnet)
After=network.target wamd-testnet.service
Wants=wamd-testnet.service

# If this unit fails, say so. A timer stays active however often the
# service under it fails, and every panel here was reading the timer:
# wam-backup failed nightly from 23 August and looked fine, and
# wam-reorg-watch failed from 03:11 UTC on 1 September and looked fine.
# Both were found by a person going and looking.
OnFailure=wam-alert@%n.service

[Service]
Type=simple
WorkingDirectory=/home/grgo/wam/pool
ExecStart=/usr/bin/node /home/grgo/wam/pool/server.js --config /home/grgo/wam/pool/config.testnet.json
Restart=always
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=default.target
