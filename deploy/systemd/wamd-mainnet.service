# ===========================================================================
#  The WAM mainnet node
# ===========================================================================
#
#      install -m 644 deploy/systemd/wamd-mainnet.service /etc/systemd/system/
#      systemctl daemon-reload
#      systemctl enable --now wamd-mainnet        # on 15 September, not before
#
#  Deliberately NOT enabled before launch. The ExecStartPre below turns that
#  from an instruction into a mechanism: a node started before 2026-09-15
#  runs once, stores a genesis block dated in the future, and then fails at
#  every subsequent start with an error that reads like a clock problem. See
#  scripts/genesis_gate.sh and docs/LAUNCH_DAY.md.
#
#  This unit exists in the repository rather than only on the two hosts,
#  because a machine can be replaced and a shell history cannot be read at
#  midnight.
# ===========================================================================

[Unit]
Description=WAM Coin node (mainnet)
After=network-online.target
Wants=network-online.target
# The node retries forever rather than giving up after a burst of failures:
# on a network with no other operators awake, a node that has stopped trying
# is a node nobody restarts.
StartLimitIntervalSec=0

[Service]
Type=simple

# The gate runs inside ExecStart, not as an ExecStartPre, and the difference
# is the whole point.
#
# RestartPreventExitStatus= applies to the exit status of the *main service
# process*. An ExecStartPre that fails is not that process, so with the gate
# as an ExecStartPre the unit was restarted anyway: five refusals a minute,
# forever, on both hosts. Tested, not assumed -- the first attempt at this
# file had exactly that arrangement and it looped.
#
# Written this way the gate IS the main process until it succeeds, and then
# exec replaces the shell with wamd, so systemd still tracks the daemon
# itself for MAINPID, signals and MemoryMax. A refusal exits 78 as the main
# process, which RestartPreventExitStatus below does cover, so the unit fails
# once, loudly, and stops -- and `systemctl start` reports the failure to
# whoever typed it instead of returning success on a service that is not
# running.
ExecStart=/bin/sh -c '/opt/wam/scripts/genesis_gate.sh mainnet --datadir /root/.wam-mainnet && exec /opt/wam-current-bin/wamd -chain=main -conf=/root/.wam-mainnet/wam.conf -datadir=/root/.wam-mainnet -printtoconsole'

Restart=always
RestartSec=15

# 78 is EX_CONFIG and the only status genesis_gate.sh refuses with. It means
# the configuration is wrong rather than the machine is: retrying cannot fix
# it, because what it is waiting for is the date, and systemd cannot hurry a
# clock.
RestartPreventExitStatus=78
StandardOutput=journal
StandardError=journal

# The node writes only inside its datadir, so ProtectSystem=full is enough
# and ProtectHome would break /root/.wam-mainnet.
NoNewPrivileges=true
ProtectSystem=full
MemoryMax=2G

[Install]
WantedBy=multi-user.target
