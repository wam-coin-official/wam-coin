# ===========================================================================
#  WAM backup -- the megabyte that cannot be rebuilt
# ===========================================================================
#
#  Triggered by wam-backup.timer, not enabled directly.
#
#  This one runs as root and is not confined the way wam-announce is, and the
#  reason is worth stating rather than leaving as an inconsistency: it must
#  read wallet.dat and the Redis dump, both of which are root-only by design,
#  and it must talk to the node's RPC socket. A confined user with access to
#  all of that would be a second root, which is not an improvement.
#
#  What it does NOT get is a route off this machine. A backup script that can
#  reach the internet is a backup script that can be turned into an
#  exfiltration tool by anything that compromises it. Copies leave this
#  machine by being pulled from outside, over SSH, by a person who already
#  has the key.
#
#  THAT WAS ONCE WRITTEN AS PrivateNetwork=yes, AND IT BROKE THE BACKUP.
#
#  Two lines above said the script must talk to the node's RPC socket, and
#  two lines below took the socket away. PrivateNetwork gives the service an
#  empty network namespace: its 127.0.0.1 is not the host's, so the node is
#  unreachable, and RestrictAddressFamilies=AF_UNIX forbade the IP socket
#  outright. Every nightly run since 23 August failed with
#
#      the node is not answering, so no consistent wallet copy can be taken
#
#  which is exactly what the script should say when the node is down, and the
#  node was up the whole time. The timer stayed green, the service failed
#  quietly at 03:27 every morning, and the newest archive on this host was
#  three days old before anybody looked. The one thing the backup exists to
#  protect -- keys that cannot be rebuilt -- was the thing going unprotected.
#
#  IPAddressAllow is the precise tool for what the header actually wants:
#  loopback reaches the node, everything else is refused by the kernel.
#  Verified both ways on the host: wam-cli returns a block height, and curl
#  to the internet times out.
# ===========================================================================

[Unit]
Description=WAM Coin encrypted backup (wallets, share ledger, config)
Documentation=https://github.com/wam-coin-official/wam-coin/blob/main/deploy/wam-backup.sh

# Wants, not Requires: if the node is down the script refuses to take a
# wallet copy and says why, which is the correct outcome and should be
# visible in the journal rather than skipped silently.
After=wamd.service redis-server.service
Wants=wamd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wam-backup.sh

# Everything below is host-specific and belongs in an override rather than
# here, e.g. mainnet:
#     systemctl edit wam-backup.service
#     [Service]
#     Environment=WAM_NETWORK=mainnet
Environment=WAM_NETWORK=testnet

# wam-cli finds the node's cookie and config under $HOME/.wam. systemd sets
# no HOME for a service that names no User=, so it looked in /.wam and
# reported "Could not locate RPC credentials" -- the second half of the same
# outage, and invisible until the first half was fixed.
Environment=HOME=/root

# Loopback only. See the header for what this replaced and why.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

# PrivateTmp is deliberately NOT set here.
#
# wamd runs with PrivateTmp=yes, so it already has a /tmp of its own. If this
# service had one too, the two namespaces would differ and backupwallet would
# fail with SQLite error 14, "cannot open file" -- which reads exactly like a
# corrupt wallet and is not one. The script stages next to its destination
# under /root for the same reason; this line exists so nobody adds the
# directive back as a tidy-up and spends an evening on it.

TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
