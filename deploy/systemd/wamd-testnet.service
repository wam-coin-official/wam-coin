[Unit]
Description=WAM Coin node (testnet)
After=network.target

# If this unit fails, say so. A timer stays active however often the
# service under it fails, and every panel here was reading the timer:
# wam-backup failed nightly from 23 August and looked fine, and
# wam-reorg-watch failed from 03:11 UTC on 1 September and looked fine.
# Both were found by a person going and looking.
OnFailure=wam-alert@%n.service

[Service]
Type=simple
ExecStart=/home/grgo/wam/build/wam-core/src/wamd -testnet -datadir=/home/grgo/wam-testnet -rpcuser=t -rpcpassword=t -rpcport=19556 -listen=0 -fallbackfee=0.0001 -printtoconsole=1
ExecStop=/home/grgo/wam/build/wam-core/src/wam-cli -testnet -datadir=/home/grgo/wam-testnet -rpcuser=t -rpcpassword=t -rpcport=19556 stop
Restart=always
RestartSec=5
TimeoutStopSec=120

[Install]
WantedBy=default.target
