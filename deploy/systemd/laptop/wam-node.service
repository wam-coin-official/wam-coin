# ===========================================================================
#  The founder's node, inside WSL
# ===========================================================================
#
#  It kept coming back on the wrong version. Windows restarts, WSL stops,
#  and the node is started again by pressing the up arrow -- which replays a
#  command line written weeks ago, pointing at an old build directory and
#  carrying -fallbackfee=0.0001, a workaround for a defect that v0.1.4 fixed
#  properly. On 2026-08-22 the network showed four nodes on 0.1.4 and this
#  one on 0.1.3, hours after it had been updated and verified.
#
#  So the version is written down here instead of typed from memory.
#
#  Deliberately absent: -fallbackfee. The binary carries the correct default
#  now, and passing it by hand would hide whether the real fix works.
# ===========================================================================

[Unit]
Description=WAM Coin node (testnet)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=grgo
Group=grgo

# The full path, pinned to the released build. Not a relative path and not
# whatever ~/wam happens to contain: that directory holds the old 0.1.3 tree
# and is what the up arrow keeps reaching for.
# No -rpcuser and no -rpcpassword.
#
# They used to read `-rpcuser=t -rpcpassword=t`, on the command line, where
# every process on the machine can read them out of /proc. A one-character
# password is not the problem -- the problem is that a password on a command
# line is readable by anything that can run `ps`, whatever it says.
#
# Leaving them out is not weaker, it is stronger: wamd then writes a .cookie
# in the datadir, a fresh random secret each run, readable only by the user
# it runs as. wam-cli finds it from -datadir with nothing to remember and
# nothing to type. It is Bitcoin Core's default for this reason.
#
# It also fixed the thing that exposed it. `wam-cli getblockcount` on this
# machine answered "Could not locate RPC credentials", which reads like a
# broken node, about a node that was perfectly healthy and following the tip.
# The founder could not query his own node from the command line at all.
#
# Nothing else on this machine used those credentials: wam-miner talks to the
# pool over the network, not to this node's RPC.
ExecStart=/home/grgo/wam-current-bin/wamd \
    -testnet \
    -datadir=/home/grgo/wam-testnet \
    -rpcport=19554 \
    -listen=0 \
    -addnode=pool.wamcoin.org:19555 \
    -addnode=electrum2.wamcoin.org:19555 \
    -printtoconsole=1

# Two anchors by name, not by address, so a server changing IP does not
# leave this node alone on the network with no way to find anyone.

Restart=always
RestartSec=15

# printtoconsole sends everything to the journal:  journalctl -u wam-node -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
